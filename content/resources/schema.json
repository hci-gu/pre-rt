{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Word resource bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "parserVersion",
    "sourceDocumentHash",
    "manifestHash",
    "resources",
    "collections",
    "assets",
    "issues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "parserVersion": {
      "type": "string"
    },
    "sourceDocumentHash": {
      "type": "string"
    },
    "manifestHash": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mediaType": {
            "const": "image/png"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "bytes": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "path",
          "mediaType",
          "width",
          "height",
          "bytes"
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "code",
          "message",
          "blocking"
        ]
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "paragraph": {
          "type": "integer"
        },
        "paraId": {
          "type": "string"
        }
      },
      "required": []
    },
    "audience": {
      "type": "object",
      "properties": {
        "arms": {
          "type": "array",
          "items": {
            "enum": [
              "PRE",
              "POST"
            ]
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "enum": [
              "before",
              "during",
              "after"
            ]
          }
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "inline": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "href": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "block": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "type",
            "inline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "subheading"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "type",
            "inline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "quote"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "required": [
            "type",
            "inline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "linkButton"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "inline": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            },
            "href": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "inline"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "list"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "ordered": {
              "type": "boolean"
            },
            "start": {
              "type": "integer"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "blocks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/block"
                    }
                  }
                },
                "required": [
                  "blocks"
                ]
              }
            }
          },
          "required": [
            "type",
            "ordered",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "image"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "asset": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "decorative": {
              "type": "boolean"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "crop": {
              "type": "object",
              "properties": {
                "l": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "t": {
                  "type": "number"
                },
                "b": {
                  "type": "number"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "url": {
              "type": "string"
            },
            "placeholder": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "asset",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "video"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "asset": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "decorative": {
              "type": "boolean"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "crop": {
              "type": "object",
              "properties": {
                "l": {
                  "type": "number"
                },
                "r": {
                  "type": "number"
                },
                "t": {
                  "type": "number"
                },
                "b": {
                  "type": "number"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "url": {
              "type": "string"
            },
            "placeholder": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "asset",
            "alt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "callout"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "tone": {
              "enum": [
                "advice",
                "emergency"
              ]
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "type",
            "tone",
            "blocks"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "columns"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          },
          "required": [
            "type",
            "columns"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "audienceGroup"
            },
            "source": {
              "$ref": "#/$defs/source"
            },
            "audience": {
              "$ref": "#/$defs/audience"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "required": [
            "type",
            "audience",
            "blocks"
          ],
          "additionalProperties": false
        }
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "schemaVersion",
        "audience",
        "blocks"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "type": "string"
        },
        "existingId": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "contentHash": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleHistory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collection": {
          "type": "string"
        }
      },
      "required": [
        "sourceKey",
        "existingId",
        "content",
        "source",
        "contentHash",
        "title",
        "titleHistory",
        "collection"
      ]
    },
    "collection": {
      "type": "object",
      "properties": {
        "sourceKey": {
          "type": "string"
        },
        "existingId": {
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "contentHash": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "showQuickExit": {
          "type": "boolean"
        },
        "sort": {
          "type": "number"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sourceKey",
        "existingId",
        "content",
        "source",
        "contentHash",
        "name",
        "visible",
        "showQuickExit",
        "sort",
        "resources"
      ]
    }
  }
}
